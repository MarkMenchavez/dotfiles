{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "ollama/qwen3.8-flash-next:125b-mlx",

  "agents": {
    "build": {
      "model": "ollama/qwen3-coder-next:q4_K_M"
    },
    "plan": {
      "model": "ollama/qwen3.8-flash-next:125b-mlx#medium"
    },
    "architect": {
      "model": "ollama/qwen3.8-flash-next:125b-mlx#xhigh"
    },
    "specialist": {
      "model": "ollama/inkling-2-mini:26b-a5b-nvfp4"
    },
    "reviewer": {
      "model": "ollama/gemma4:31b-mlx"
    },
    "general": {
      "model": "ollama/qwen3.8:27b-mlx"
    },
    "explore": {
      "model": "ollama/qwen3.6:35b-a3b-coding-mxfp8#low"
    },
    "compaction": {
      "model": "ollama/qwen3.6:35b-a3b-coding-mxfp8#low"
    },
    "title": {
      "model": "ollama/qwen3.6:35b-a3b-coding-mxfp8#none"
    },
    "summary": {
      "model": "ollama/qwen3.6:35b-a3b-coding-mxfp8#low"
    }
  },

  "providers": {
    "ollama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://10.0.2.2:11434/v1",
        "timeout": 900000,
        "headerTimeout": 120000
      },

      "models": {
        "qwen3.8-flash-next:125b-mlx": {
          "name": "Qwen 3.8 Flash Next 125B NVFP4 MLX",
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "xhigh"]
            }
          },
          "body": {
            "temperature": 0.2
          }
        },

        "qwen3-coder-next:q4_K_M": {
          "name": "Qwen3 Coder Next 80B-A3B Q4_K_M",
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "body": {
            "temperature": 0.2,
            "top_p": 0.95
          }
        },

        "qwen3.6:35b-a3b-coding-mxfp8": {
          "name": "Qwen3.6 35B-A3B Coding MXFP8",
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["none", "low", "medium", "high"]
            }
          },
          "body": {
            "temperature": 0.2
          },
          "variants": [
            {
              "id": "none",
              "body": {
                "reasoning_effort": "none"
              }
            },
            {
              "id": "low",
              "body": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "body": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning_effort": "high"
              }
            }
          ]
        },

        "qwen3.8:27b-mlx": {
          "name": "Qwen3.8 27B MLX",
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "xhigh"]
            }
          },
          "body": {
            "temperature": 0.6,
            "top_p": 0.95
          },
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "body": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "xhigh",
              "body": {
                "reasoning_effort": "xhigh"
              }
            }
          ]
        },

        "inkling-2-mini:26b-a5b-nvfp4": {
          "name": "Inkling 2 Mini 26B-A5B NVFP4",
          "limit": {
            "context": 32768,
            "output": 16384
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true
            }
          }
        },

        "gemma4:31b-mlx": {
          "name": "Gemma 4 31B MLX",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": {
              "supported": true
            }
          },
          "body": {
            "temperature": 0.1
          }
        }
      }
    }
  }
}